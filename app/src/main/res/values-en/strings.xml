    <string name="policy_follow_host">Follow AutoJs6</string>
    <string name="policy_follow_host_summary">Enable the compatibility service only while the AutoJs6 accessibility service is enabled</string>
    <string name="privacy_body">The service callback is a no-op. The plugin does not read event sources, event text, root nodes, screenshots, or user content. It does not store or share data and has no network access. The service receives events only from packages in the published support list. When you allow it, the app changes only the list of enabled accessibility services through root, secure settings, or Shizuku, and never touches other settings.</string>
    <string name="privacy_title">Privacy</string>
