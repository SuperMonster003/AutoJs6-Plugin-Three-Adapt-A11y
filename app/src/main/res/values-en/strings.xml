    <string name="limitations_body">Compatibility depends on the target app version, page, and device, and may stop working after an update. This service cannot create semantic nodes that a page does not expose. Controls in WebView, Canvas, and custom-drawn interfaces may remain unavailable.</string>
    <string name="limitations_title">Limitations</string>
